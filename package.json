{
  "name": "storm-island",
  "private": true,
  "description": "A browser game built with three.js. The game code is TypeScript in src/, bundled into game.js.",
  "scripts": {
    "build": "esbuild src/game.ts --bundle --format=iife --target=es2019 --outfile=game.js --log-level=warning",
    "watch": "esbuild src/game.ts --bundle --format=iife --target=es2019 --outfile=game.js --watch",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/three": "^0.128.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
